# Server-only Supabase Edge Function secrets. Configure with `supabase secrets set`.
# Never prefix these with VITE_ and never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=

# AI Content Studio. `mock` is deterministic and requires no provider key.
# Add a provider adapter before selecting another provider in production.
AI_CONTENT_PROVIDER=mock
AI_TEXT_API_KEY=
AI_IMAGE_API_KEY=
